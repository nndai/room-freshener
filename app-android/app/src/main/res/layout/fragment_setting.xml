<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/settingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cài đặt hệ thống"
        android:textAppearance="@android:style/TextAppearance.Material.Headline"
        app:layout_constraintBottom_toTopOf="@+id/settingSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/settingSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Điều chỉnh hương liệu, cường độ và người dùng."
        android:textAppearance="@android:style/TextAppearance.Material.Body1"
        app:layout_constraintTop_toBottomOf="@+id/settingTitle"
        app:layout_constraintStart_toStartOf="@+id/settingTitle"
        app:layout_constraintEnd_toEndOf="@+id/settingTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>