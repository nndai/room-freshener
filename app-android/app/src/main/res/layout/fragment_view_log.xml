<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/logTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nhật ký hoạt động"
        android:textAppearance="@android:style/TextAppearance.Material.Headline"
        app:layout_constraintBottom_toTopOf="@+id/logSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/logSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Xem lịch sử phun và cảnh báo mới nhất."
        android:textAppearance="@android:style/TextAppearance.Material.Body1"
        app:layout_constraintTop_toBottomOf="@+id/logTitle"
        app:layout_constraintStart_toStartOf="@+id/logTitle"
        app:layout_constraintEnd_toEndOf="@+id/logTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>